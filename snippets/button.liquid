{% doc %}
  Renders a link styled as a button.

  @param {string} text - Button label.
  @param {string} url - Link destination.
{% enddoc %}

<a href="{{ url }}" class="btn">{{ text }}</a>

{% stylesheet %}
  .btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: #000;
    color: #fff;
    text-decoration: none;
  }
{% endstylesheet %}
